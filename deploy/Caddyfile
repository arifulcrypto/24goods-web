# 24goods edge — Caddy 2.11
#
# SITE_ADDRESS examples:
#   ":80"                       demo on a bare public IP, plain HTTP, mock data only
#   "shop.example.com"          production single domain, automatic HTTPS (Let's Encrypt)
#
# Reseller custom domains (M4) use On-Demand TLS — see the commented block at
# the bottom. On-Demand TLS MUST stay gated by the `ask` endpoint (docs/architecture.md §9.2).

{
	admin off
	# Don't trust client-supplied X-Forwarded-For; Caddy is the first hop. Behind Cloudflare
	# (demo.kesiv.com) the visitor IP comes from CF-Connecting-IP, trusted only from CF ranges.
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
		timeouts {
			read_header 10s
			idle 2m
		}
	}

	# --- M4 only: enable when the first reseller domain is onboarded -------
	# on_demand_tls {
	#     # Internal listener of the API (never routed publicly). Returns 200 only
	#     # for hostnames in custom_domains that are TXT-verified and active;
	#     # negative-cached and rate-limited (docs/architecture.md §9.2).
	#     ask http://api:8081/internal/tls/ask
	# }
}

(security_headers) {
	# `?` = set only if the upstream didn't: the API's stricter per-response headers
	# (e.g. `Content-Security-Policy: sandbox` on /api/v1/files/*) must win (security review M6).
	header {
		?Strict-Transport-Security "max-age=63072000; includeSubDomains"
		?X-Content-Type-Options "nosniff"
		?X-Frame-Options "DENY"
		?Referrer-Policy "strict-origin-when-cross-origin"
		?Permissions-Policy "camera=(), geolocation=(), microphone=(self)"
		?Cross-Origin-Opener-Policy "same-origin"
		?Content-Security-Policy "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self'; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}
}

(app) {
	import security_headers
	encode zstd gzip
	request_body {
		max_size 10MB
	}

	# API (incl. SSE: flush immediately, long-lived)
	handle /api/* {
		reverse_proxy api:8000 {
			flush_interval -1
			header_up X-Forwarded-For {client_ip}
			transport http {
				read_timeout 0
			}
		}
	}

	# Demo-only ZPay simulator. Remove this block in production.
	handle_path /mockpay/* {
		reverse_proxy mockpay:8002
	}

	# Staff dashboard (PC). In production restrict further (VPN / Cloudflare Access).
	redir /admin /admin/ 308
	handle_path /admin/* {
		root * /srv/admin
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}

	# Buyer SPA (mobile-first)
	handle {
		root * /srv/web
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		@html path / /index.html
		header @html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format json
	}
}

{$SITE_ADDRESS::80} {
	import app
}

# --- M4: reseller custom domains via On-Demand TLS ------------------------
# https:// {
#     tls {
#         on_demand
#     }
#     import app
# }

# --- Reseller custom domains via Cloudflare for SaaS (v5.2) ------------------
# Cloudflare terminates TLS for the customer's hostname and forwards it to the fallback origin
# (stores.<domain>). When SITE_ADDRESS is a real domain, Caddy would answer other Host headers
# with nothing, so accept them on the plain-HTTP origin port WITHOUT issuing certificates
# (no on_demand, no `ask` needed). The Host header reaches the API unchanged and the storefront
# is resolved from the reseller_domains table. Enable only if Cloudflare reaches the origin on
# :80 (SSL mode flexible) or via an origin rule; the existing on-demand `tls_ask` flow above is
# independent and unchanged.
# http:// {
#     import app
# }
