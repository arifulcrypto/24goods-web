# 24goods edge — Caddy 2.11
#
# SITE_ADDRESS examples:
#   ":80"                       demo on a bare public IP, plain HTTP, mock data only
#   "shop.example.com"          production single domain, automatic HTTPS (Let's Encrypt)
#
# Reseller custom domains (M4) use On-Demand TLS — see the commented block at
# the bottom. On-Demand TLS MUST stay gated by the `ask` endpoint (docs/architecture.md §9.2).

{
	admin off
	# Don't trust client-supplied X-Forwarded-For; Caddy is the first hop. Behind Cloudflare
	# (demo.kesiv.com) the visitor IP comes from CF-Connecting-IP, trusted only from CF ranges.
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
		timeouts {
			read_header 10s
			idle 2m
		}
	}

	# --- M4 only: enable when the first reseller domain is onboarded -------
	# on_demand_tls {
	#     # Internal listener of the API (never routed publicly). Returns 200 only
	#     # for hostnames in custom_domains that are TXT-verified and active;
	#     # negative-cached and rate-limited (docs/architecture.md §9.2).
	#     ask http://api:8081/internal/tls/ask
	# }
}

(security_headers) {
	# `?` = set only if the upstream didn't: the API's stricter per-response headers
	# (e.g. `Content-Security-Policy: sandbox` on /api/v1/files/*) must win (security review M6).
	header {
		?Strict-Transport-Security "max-age=63072000; includeSubDomains"
		?X-Content-Type-Options "nosniff"
		?X-Frame-Options "DENY"
		?Referrer-Policy "strict-origin-when-cross-origin"
		# `microphone=(self)` is load-bearing, not an oversight: chat voice clips call
		# getUserMedia from this origin (shared/media/voice.ts, used by the buyer ChatComposer
		# and the staff composer). `microphone=()` would silently break voice messages, so a
		# scanner asking to tighten it is wrong for this app. camera/geolocation stay denied.
		?Permissions-Policy "camera=(), geolocation=(), microphone=(self)"
		?Cross-Origin-Opener-Policy "same-origin"
		# Everything (SPA, admin, API, uploads) is one origin, including reseller custom hosts,
		# which serve the same SPA with relative URLs -- so nothing legitimate embeds our
		# resources cross-origin.
		?Cross-Origin-Resource-Policy "same-origin"
		?Content-Security-Policy "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self'; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		# do not advertise the proxy or its version
		-Server
		-Via
	}
}

(app) {
	import security_headers
	encode zstd gzip
	request_body {
		max_size 10MB
	}

	# API (incl. SSE: flush immediately, long-lived)
	handle /api/* {
		reverse_proxy api:8000 {
			flush_interval -1
			header_up X-Forwarded-For {client_ip}
			transport http {
				read_timeout 0
			}
		}
	}

	# SEO documents rendered by the API (review-v5.2 §6, ADR-024): crawler HTML + first paint.
	# The SPA still boots from the same shell; the API serves it with per-route metadata. If the
	# API cannot answer (down / 503 shell unavailable) the static shell is served instead.
	@seo path / /p/* /a/* /help /search /sitemap.xml /robots.txt /ai.txt
	handle @seo {
		reverse_proxy api:8000 {
			header_up X-Forwarded-For {client_ip}
			header_up -X-Storefront
			@unavailable status 502 503 504
			handle_response @unavailable {
				root * /srv/web
				rewrite * /index.html
				file_server
			}
		}
	}

	# Demo-only ZPay simulator. Remove this block in production.
	handle_path /mockpay/* {
		reverse_proxy mockpay:8002
	}

	# Demo-only BEpusdt simulator: ONLY its "simulate payment" page. Remove in production.
	handle /mockusdt/pay/* {
		reverse_proxy mockusdt:8003
	}

	# Staff dashboard (PC). In production restrict further (VPN / Cloudflare Access).
	redir /admin /admin/ 308
	handle_path /admin/* {
		root * /srv/admin
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}

	# Buyer SPA (mobile-first)
	handle {
		root * /srv/web
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		@html path / /index.html
		header @html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	handle_errors {
		@seo_down {
			path / /p/* /a/* /help /search
			expression {http.error.status_code} in [502, 503, 504]
		}
		handle @seo_down {
			root * /srv/web
			rewrite * /index.html
			file_server
		}
	}

	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri regexp "\\?.*$" ""
				request>headers>Referer delete
				request>headers>X-Turnstile-Token delete
				request>headers>X-Access-Code delete
				request>headers>X-Api-Key delete
			}
		}
	}
}

{$SITE_ADDRESS::80} {
	import app
}

# Internal only (edge network, never published): the API fetches the built SPA shell from here
# to render the SEO pages (APP_WEB_INDEX_URL=http://web/index.html). /index.html and nothing else.
http://web {
	handle /index.html {
		root * /srv/web
		file_server
	}
	handle {
		respond 404
	}
}

