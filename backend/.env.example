# 24goods backend configuration. Copy to .env for local development.
# NEVER commit real values. Generate secrets with:
#   python -m app.devtools.keygen --out-dir ./secrets   (writes secrets/secrets.env + key files)

# ---------------------------------------------------------------- general
# dev | test | staging | prod (prod disables /api/docs, mockpay)
APP_ENV=dev
APP_LOG_LEVEL=INFO

# ---------------------------------------------------------------- listeners
# public API bind (the Docker image sets 0.0.0.0)
APP_HOST=127.0.0.1
APP_PORT=8000
# internal listener (Caddy TLS ask); never route it publicly
APP_INTERNAL_HOST=127.0.0.1
APP_INTERNAL_PORT=8081
# CIDRs whose X-Forwarded-For is trusted (Caddy)
APP_TRUSTED_PROXIES=127.0.0.1/32,::1/128
# used to build notify_url / return_url
APP_PUBLIC_BASE_URL=http://localhost:8080

# ---------------------------------------------------------------- storage
APP_DATABASE_URL=postgresql+asyncpg://app_api:change-me-api@localhost:5432/goods24
APP_DB_POOL_SIZE=4
APP_DB_MAX_OVERFLOW=4
APP_REDIS_URL=redis://localhost:6379/0
APP_UPLOAD_DIR=./data/uploads

# Migrations + seed run as the schema owner (role needs CREATEROLE):
APP_MIGRATE_DATABASE_URL=postgresql+asyncpg://app_owner:change-me-owner@localhost:5432/goods24
# password set on role app_api by the migration
APP_DB_API_PASSWORD=change-me-api
# password set on role app_delivery
APP_DB_DELIVERY_PASSWORD=change-me-delivery

# ---------------------------------------------------------------- sessions / tenancy
# true behind HTTPS (cookie is then named __Host-sid; "sid" only for plain-HTTP demos)
APP_COOKIE_SECURE=false
# 7 days
APP_SESSION_TTL_BUYER_S=604800
# 12 hours
APP_SESSION_TTL_STAFF_S=43200
APP_DEFAULT_TENANT_SLUG=platform

# ---------------------------------------------------------------- card vault (API: PUBLIC half only)
# or inline JSON:
APP_VAULT_PUBLIC_KEYS_FILE=./secrets/vault_public_keys.json
# APP_VAULT_PUBLIC_KEYS={"k20261105-ab12":"<base64 raw X25519 public key>"}
APP_VAULT_ACTIVE_KID=k20261105-ab12
APP_VAULT_FINGERPRINT_KEY=REPLACE_WITH_BASE64_32_BYTES
APP_QUOTE_HMAC_KEY=REPLACE_WITH_BASE64_32_BYTES

# ---------------------------------------------------------------- internal services
# shared API <-> delivery
APP_INTERNAL_TOKEN=REPLACE_WITH_RANDOM_TOKEN_MIN_32_CHARS
# where the API reaches delivery
APP_DELIVERY_URL=http://127.0.0.1:8001

# ---------------------------------------------------------------- delivery service ONLY
# These must be set for `python -m app.delivery` and NEVER for the API (it refuses to start).
# chmod 600
# APP_VAULT_PRIVATE_KEYS_FILE=./secrets/vault_private_keys.json
APP_DELIVERY_DATABASE_URL=postgresql+asyncpg://app_delivery:change-me-delivery@localhost:5432/goods24
# 0.0.0.0 inside a private Docker network
APP_DELIVERY_HOST=127.0.0.1
APP_DELIVERY_PORT=8001
# global decrypt circuit breaker
APP_REVEAL_MAX_PER_MIN=30
APP_REVEAL_PER_ORDER_PER_HOUR=10
# cards a buyer may reveal per window; set in BOTH api and delivery (each enforces it)
APP_REVEAL_PER_BUYER_CARDS=30
APP_REVEAL_PER_BUYER_WINDOW_S=600
APP_OUTBOX_POLL_S=1.0

# ---------------------------------------------------------------- orders
APP_ORDER_TTL_MINUTES=30
# max unpaid (pending_payment) orders per buyer
APP_MAX_PENDING_ORDERS=5
APP_EXPIRY_INTERVAL_S=60

# ---------------------------------------------------------------- payments: ZPay (EPay protocol)
APP_ZPAY_PID=1001
APP_ZPAY_KEY=REPLACE_WITH_MERCHANT_KEY
# browser-facing base for submit.php (demo: http://localhost:8080/mockpay)
APP_ZPAY_GATEWAY=https://zpayz.cn
# server-to-server base for api.php (demo: http://mockpay:8002)
APP_ZPAY_API_BASE=
# 1.6 % gateway fee booked to fees:zpay
APP_ZPAY_FEE_PERMILLE=16
# per source IP on /api/v1/pay/notify/* (over the limit the reply is "fail")
APP_NOTIFY_RATE_PER_MIN=120

# ---------------------------------------------------------------- dev mock gateway (never in prod)
APP_MOCKPAY_HOST=127.0.0.1
APP_MOCKPAY_PORT=8002
# e.g. http://api:8000 so the simulator reaches the API in Docker
APP_MOCKPAY_NOTIFY_BASE=

# ---------------------------------------------------------------- Caddy on-demand TLS ask
APP_TLS_ASK_RATE_PER_MIN=30

# ---------------------------------------------------------------- seed (python -m app.devtools.seed)
APP_SEED_ADMIN_PASSWORD=REPLACE_MIN_12_CHARS
APP_SEED_AGENT_PASSWORD=REPLACE_MIN_12_CHARS
APP_SEED_BUYER_PASSWORD=REPLACE_MIN_12_CHARS

# ---------------------------------------------------------------- container healthcheck
# 8001 for delivery, 8002 for mockpay
APP_HEALTH_PORT=8000
